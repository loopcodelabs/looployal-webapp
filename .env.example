# SMSLocal SMS Provider Credentials & Gateway Config
SMSLOCAL_API_KEY=
SMSLOCAL_BASE_URL=https://api.smslocal.com/v1/send
SMSLOCAL_SENDER_ID=LYLTYP
SMSLOCAL_ENTITY_ID=
SMSLOCAL_OTP_TEMPLATE_ID=
SMSLOCAL_TRANSACTION_TEMPLATE_ID=
SMSLOCAL_WELCOME_TEMPLATE_ID=
SMSLOCAL_TIMEOUT=5000
SMSLOCAL_RETRY_COUNT=3

# Notification Configuration
SMS_PROVIDER=smslocal
SMS_ENABLED=true
APPLICATION_NAME=LoyaltySaaS

# Security & OTP Configuration
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_COOLDOWN_SECONDS=30
OTP_SECRET=loyalty_saas_otp_secure_hmac_secret_key

# Database Connection (MySQL / Cloud SQL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=loyalty_saas_db

# Local Development Configuration
PORT=3000

# Timezone Configuration (Defaults to Asia/Kolkata / IST UTC+05:30)
APP_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
MYSQL_TIMEZONE=+05:30

